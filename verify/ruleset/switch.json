{
  // A switch: on, off, and on again. Written because a walk from a start somebody wrote has
  // to come back to that start for anything to show about how it was compared, and every
  // other component here only ever moves forward. Two inputs rather than one that flips, so
  // that which one is legal is what says the switch is on.
  "id": "switch",
  "version": "1.0.0",

  "requires": [
    { "plugin": "Rulealize.Plugin.TypeSchema" }, { "plugin": "Rulealize.Plugin.State" },
    { "plugin": "Rulealize.Plugin.Comparison" }
  ],

  "state": {
    "schema": { "on": { "op": "type.bool" } },
    "initial": { "on": false }
  },

  "inputs": {
    "on": {
      "when": { "op": "cmp.eq", "left": "$on", "right": false },
      "effects": [ { "op": "state.set", "path": "on", "value": true } ]
    },
    "off": {
      "when": { "op": "cmp.eq", "left": "$on", "right": true },
      "effects": [ { "op": "state.set", "path": "on", "value": false } ]
    }
  }
}
