  "terminal": {
    "when": {
      "op": "logic.or",
      "any": [
        {
          "op": "cmp.gte",
          "left": "$idle",
          "right": 100
        },
        {
          "op": "logic.not",
          "value": "#gameHasLegalMove"
        }
      ]
    },
    "result": {
      "op": "branch.if",
      "cond": {
        "op": "logic.not",
        "value": "#gameHasLegalMove"
      },
      "then": {
        "op": "branch.if",
        "cond": {
          "op": "def.call",
          "def": "gameInCheck",
          "args": {
            "colour": "#gameMe"
          }
        },
        "then": "#gameFoe",
