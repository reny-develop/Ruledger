        "in": {
          "op": "grid.withMany",
          "grid": {
            "op": "grid.with",
            "grid": {
              "op": "grid.withMany",
              "grid": "$board",
              "coords": "@cleared",
              "value": null
            },
            "coord": "@t",
            "value": "@placed"
          },
          "coords": "@rookTo",
          "value": "#gameMyRook"
