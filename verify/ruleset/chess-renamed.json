  "inputs": {
    "move": {
      "actor": "#gameMe",
      "params": {
        "m": {
          "domain": "#gamePseudoMoves"
        }
      },
      "when": {
        "op": "def.call",
        "def": "gameLegal",
        "args": {
          "m": "@m"
        }
      },
      "effects": [
        {
          "op": "state.set",
          "path": "board",
          "value": {
            "op": "def.call",
            "def": "gameBoardAfter",
            "args": {
              "m": "@m"
            }
          }
        },
        {
          "op": "state.set",
          "path": "turn",
          "value": "#gameFoe"
        },
        {
          "op": "state.set",
          "path": "ep",
          "value": {
            "op": "branch.if",
            "cond": {
              "op": "cmp.eq",
              "left": {
                "op": "def.call",
                "def": "gameTag",
                "args": {
                  "m": "@m"
                }
              },
              "right": "2"
            },
            "then": {
              "op": "seq.elementAt",
              "index": 0,
              "source": {
                "op": "grid.ray",
                "grid": "$board",
                "from": {
                  "op": "def.call",
                  "def": "gameTo",
                  "args": {
                    "m": "@m"
                  }
                },
                "dir": "#gameHomeDir",
                "length": 1
              }
            },
            "else": null
          }
        },
        {
          "op": "state.set",
          "path": "idle",
          "value": {
            "op": "branch.if",
            "cond": {
              "op": "logic.or",
              "any": [
                {
                  "op": "def.call",
                  "def": "gameIsPawnMove",
                  "args": {
                    "m": "@m"
                  }
                },
                {
                  "op": "def.call",
                  "def": "gameIsCapture",
                  "args": {
                    "m": "@m"
                  }
                }
              ]
            },
            "then": 0,
            "else": {
              "op": "math.add",
              "of": [
                "$idle",
                1
              ]
            }
          }
        },
        {
          "op": "state.set",
          "path": "wk",
          "value": {
            "op": "logic.and",
            "all": [
              "$wk",
              {
                "op": "def.call",
                "def": "gameKeeps",
                "args": {
                  "m": "@m",
                  "kingSq": "e1",
                  "rookSq": "h1"
                }
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "wq",
          "value": {
            "op": "logic.and",
            "all": [
              "$wq",
              {
                "op": "def.call",
                "def": "gameKeeps",
                "args": {
                  "m": "@m",
                  "kingSq": "e1",
                  "rookSq": "a1"
                }
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "bk",
          "value": {
            "op": "logic.and",
            "all": [
              "$bk",
              {
                "op": "def.call",
                "def": "gameKeeps",
                "args": {
                  "m": "@m",
                  "kingSq": "e8",
                  "rookSq": "h8"
                }
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "bq",
          "value": {
            "op": "logic.and",
            "all": [
              "$bq",
              {
                "op": "def.call",
                "def": "gameKeeps",
                "args": {
                  "m": "@m",
                  "kingSq": "e8",
                  "rookSq": "a8"
                }
              }
            ]
          }
        }
